# Eight-walker well-tempered metadynamics. Copy once per walker and set
# WALKERS_ID from 0 to 7. WALKERS_DIR is the shared hills directory.
# D_0 and D_MAX are Angstrom. LENGTH_SCALE converts nanometres.
UNITS LENGTH=nm
LOAD FILE=../../build/libdseams_plumed.so
ice: DSEAMS_SMOOTH_CHILL ATOMS=1-1728:4 D_0=3.2 D_MAX=3.5 LENGTH_SCALE=10.0
metad: METAD ARG=ice SIGMA=0.06 HEIGHT=1.5 BIASFACTOR=200 TEMP=210 PACE=250 GRID_MIN=0 GRID_MAX=1 GRID_BIN=150 FILE=HILLS WALKERS_N=8 WALKERS_ID=0 WALKERS_DIR=hills WALKERS_RSTRIDE=250
PRINT ARG=ice,metad.bias STRIDE=500 FILE=COLVAR
