integrator  = md
dt          = 0.001
nsteps      = 20
nstxout     = 0
nstvout     = 0
nstfout     = 0
nstlog      = 10
nstenergy   = 10
cutoff-scheme = Verlet
nstlist     = 10
pbc         = xyz
coulombtype = Cut-off
rcoulomb    = 0.45
rvdw        = 0.45
tcoupl      = v-rescale
tc-grps     = System
tau-t       = 0.1
ref-t       = 260
gen-vel     = yes
gen-temp    = 260
gen-seed    = 1
constraints = h-bonds
