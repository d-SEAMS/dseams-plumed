integrator  = md
dt          = 0.002
nsteps      = 50000
nstxout     = 0
nstvout     = 0
nstfout     = 0
nstlog      = 5000
nstenergy   = 1000
nstxout-compressed = 0
cutoff-scheme = Verlet
nstlist     = 20
pbc         = xyz
coulombtype = PME
rcoulomb    = 0.9
rvdw        = 0.9
rlist       = 0.9
verlet-buffer-tolerance = -1
fourierspacing = 0.12
tcoupl      = v-rescale
tc-grps     = System
tau-t       = 0.2
ref-t       = 210
gen-vel     = yes
gen-temp    = 210
gen-seed    = 11
constraints = h-bonds
pcoupl      = C-rescale
tau-p       = 1.0
ref-p       = 1.0
compressibility = 4.5e-5
