# PLUMED 2.10 or later. The source module includes seams-core v2.14.0.
UNITS LENGTH=A
LOAD FILE=dseams_plumed.cpp

# Cubic-diamond ice
ice: DSEAMS_CAGES ATOMS=1-512 CUTOFF=3.5 CANDIDATE=5.5 K=4 LENGTH_SCALE=1 COMPLETE
PRINT ARG=ice.nice,ice.nmax,ice.nclus,ice.nic,ice.nih,ice.chillice,ice.chillmax STRIDE=1 FILE=ICE FMT=%8.0f

# Two ions replacing water sites in a second cubic-diamond lattice
brine: DSEAMS_CAGES ATOMS=513-1022 IONS=1023-1024 ION_CUTOFF=3.5 CUTOFF=3.5 CANDIDATE=5.5 K=4 LENGTH_SCALE=1 COMPLETE
PRINT ARG=brine.nice,brine.nmax,brine.nionice,brine.nionfront,brine.nionliq STRIDE=1 FILE=BRINE FMT=%8.0f

# Periodic cubic cages with one guest in each of 64 cages
hyd: DSEAMS_CAGES ATOMS=1025-1536 GUESTS=1537-1600 CUTOFF=3.5 CANDIDATE=4.8 K=6 LENGTH_SCALE=1 SIGNATURE=4:6 GUEST_RADIUS=3.0
PRINT ARG=hyd.ncages,hyd.noccupied,hyd.nmultiple,hyd.nfreeguest STRIDE=1 FILE=HYDRATE FMT=%8.0f
